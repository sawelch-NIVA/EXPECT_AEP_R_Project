  title = {Benthic Community Status and Mobilization of {{Ni}}, {{Cu}} and {{Co}} at Abandoned Sea Deposits for Mine Tailings in {{SW Norway}}.},
  author = {{Schaanning MT} and {Trannum HC} and {\O xnevad S} and {Ndungu K}},
  year = 2019,
  journal = {Mar Pollut Bull},
  volume = {141},
