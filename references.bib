}

@article{sandersonComprehensivePrioritisationScheme2025,
  title = {Comprehensive Prioritisation Scheme for Active Pharmaceutical Ingredients in {{Denmark}}},
  author = {Sanderson, Hans and Bengtstr{\"o}m, Linda and Fauser, Patrik and Carvalho, Pedro N. and Hansen, Martin and Nanusha, Mulatu Y. and Lassen, Pia and Bester, Kai},
  year = 2025,
  month = sep,
  journal = {RSC Sustainability},
  pages = {10.1039.D5SU00120J},
  publisher = {RSC},
  issn = {2753-8125},
  doi = {10.1039/D5SU00120J},
  urldate = {2025-09-21},
  abstract = {Active pharmaceutical ingredients (APIs) can cause severe adverse effects if released into the environment. In response to the 2574 APIs approved in Denmark and costly environmental monitoring initiatives, a prioritisation scheme is presented to identify candidate substances for further investigation, based on their hazard, use and risk. The proposed prioritisation scheme consists of three subsequent filters; human toxicology and ecotoxicology followed by reported Danish use and lastly measured or predicted environmental concentration and risk ratios based on these. Actions, such as assigning scores for missing data, were implemented to generate a final list of 300 APIs. These substances may be considered in the design of future monitoring campaigns aimed at investigating the contamination of pharmaceuticals in aquatic environments via effluent discharge. All in all, 84\% among the top-50 priority APIs have not previously been included in chemical analysis of any environmental samples in Denmark. These APIs belonged to therapeutic groups such as treatments for hypertension, antibiotics, antifungals, antineoplastics, and medicines affecting the nervous system. Of particular concern is metformin, clindamycin and clotrimazole as these are all amongst the highest ranked, and also appears on the EU Commission's watch list of substances for EU-wide monitoring in the field of water policy. Yet despite reported use in Denmark, there are currently no monitoring data available for neither of these APIs. Most of the highest ranked APIs are used to treat chronic diseases or symptoms, such as treatments for hypertension and anticonvulsant medicines. The scheme can be continuously updated, and depending on the availability of data in different countries further implemented in other geographies.},
  langid = {english},
  keywords = {/unread},
  annotation = {TLDR: In response to the 2574 APIs approved in Denmark and costly environmental monitoring initiatives, a prioritisation of priorities for new APIs is being considered.\\
Citations: 0 (Crossref) [2025-09-26]\\
Citations: 0 (SemanticScholar) [2025-09-26]},
