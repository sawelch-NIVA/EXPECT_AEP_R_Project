@article{wahlstromProjectedClimateChange2022,
  title = {Projected Climate Change Impact on a Coastal Sea---{{As}} Significant as All Current Pressures Combined},
  author = {W{\aa}hlstr{\"o}m, Ir{\'e}ne and Hammar, Linus and Hume, Duncan and P{\aa}lsson, Jonas and {Almroth-Rosell}, Elin and Dieterich, Christian and Arneborg, Lars and Gr{\"o}ger, Matthias and Mattsson, Martin and Zill{\'e}n Snowball, Lovisa and K{\aa}gesten, Gustav and T{\"o}rnqvist, Oscar and Breviere, Emilie and Brunnabend, Sandra-Esther and Jonsson, Per R.},
