@article{efsaGuidanceTieredRisk2013,
  title = {Guidance on Tiered Risk Assessment for Plant Protection Products for Aquatic Organisms in Edge-of-Field Surface Waters},
  author = {{EFSA}},
  year = 2013,
  journal = {EFSA Journal},
  volume = {11},
  number = {7},
  issn = {18314732},
  doi = {10.2903/j.efsa.2013.3290.Available},
  abstract = {EFSA`s Panel on Plant Protection Products and their Residues (PPR) was tasked to revise the Guidance\textbackslash nDocument (GD) on Aquatic Ecotoxicology under Council Directive 91/414/EEC (SANCO/3268/2001 rev.4\textbackslash n(final), 17 October 2002). This Guidance of the PPR Panel is the first of three requested deliverables within this\textbackslash nmandate. It has its focus on tiered acute and chronic effect assessment schemes with detailed guidance on tier 1\textbackslash nand higher tier effect assessments for aquatic organisms in edge-of-field surface waters and on proposals\textbackslash nregarding how to link effects to exposure estimates. The exposure assessment methodology was not reviewed\textbackslash nand it is assumed that the current FOCUS surface water exposure assessment methodology will continue to be\textbackslash nused for exposure assessment at EU level. The current GD is intended to be used for authorisation of active\textbackslash nsubstances at EU level as well as for plant protection products at Member State level. The effect assessment\textbackslash nschemes in this GD allow for the derivation of regulatory acceptable concentrations (RACs) on the basis of two\textbackslash noptions: (1) the ecological threshold option (ETO), accepting negligible population effects only, and (2) the\textbackslash necological recovery option (ERO), accepting some population-level effects if ecological recovery takes place\textbackslash nwithin an acceptable time period. In the tiered effect assessment schemes, in principle, all tiers (1, 2 and 3) are\textbackslash nable to address the ETO, while the model ecosystem approach (tier 3), under certain conditions, is able to also\textbackslash naddress the ERO. The GD provides the scientific background for the risk assessment to aquatic organisms in\textbackslash nedge-of-field surface waters and is structured to give detailed guidance on all assessment steps. An executive\textbackslash nsummary joining all parts of the guidance and decision schemes in a concise way is provided and is intended to\textbackslash nhelp applicants and regulatory authorities in day-to-day use.}
}

