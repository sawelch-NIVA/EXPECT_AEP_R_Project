@article{hansenReviewOilToxicity2023,
  title = {Review of {{Oil Toxicity}} in {{Arctic Calanus Copepods}}},
  author = {Hansen, Bj{\o}rn Henrik and Salaberria, I. and Olsen, A.J. and Read, K.E. and {\O}verjordet, I.B. and Hammer, K.M. and Altin, D. and Nordtug, T.},
  year = 2023,
  journal = {Journal of Toxicology and Environmental Health, Part B},
  volume = {88},
  number = {2},
  pages = {67--84},
  issn = {1528-7394},
  doi = {10.1080/15287394.2023.2271003},
  urldate = {2025-02-17},
  abstract = {Accidental crude oil spills to the marine environment cause dispersion of oil into the water column through the actions of breaking waves, a process that can be facilitated using chemical dispersants. Oil dispersions contain dispersed micron-sized oil droplets and dissolved oil components, and the toxicity of oil dispersions has been assumed to be associated primarily with the latter. However, most hydrophobic, bioaccumulative and toxic crude oil components are retained within the droplets which may interact with marine filter-feeders. We here summarize the findings of 15 years of research using a unique methodology to generate controlled concentrations and droplet size distributions of dispersed crude oil to study effects on the filter-feeding cold-water copepod Calanus finmarchicus. We focus primarily on the contribution of chemical dispersants and micron-sized oil droplets to uptake and toxicity of oil compounds. Oil dispersion exposures cause PAH uptake and oil droplet accumulation on copepod body surfaces and inside their gastrointestinal tract, and exposures to high exposure (mg/L range) reduce feeding activity, causes reproductive impairments and mortality. These effects were slightly higher in the presence of chemical dispersants, possibly due to higher filtration of chemically dispersed droplets. For C. finmarchicus, dispersions containing oil droplets caused more severe toxic effects than filtered dispersions, thus, oil droplets contribute to the observed toxicity. The methodology for generating crude oil dispersion is a valuable tool to isolate impacts of crude oil microdroplets and can facilitate future research on oil dispersion toxicity and produce data to improve oil spill models.},
  langid = {english},
  keywords = {/unread,Biota/invert/cladocera},
  annotation = {Citations: 2 (SemanticScholar) [2025-09-26]\\
TLDR: The methodology for generating crude oil dispersion is a valuable tool to isolate impacts of crude oil microdroplets and can facilitate future research on oil dispersion toxicity and produce data to improve oil spill models.},
  file = {C:\Users\SAW\OneDrive - NIVA\Documents\04 - Library\Literature\Hansen et al. - 2023 - Review of Oil Toxicity in Arctic Calanus Copepods.pdf}
}

@article{hansenUsePAHMetabolite2020,
  title = {The Use of {{PAH}}, Metabolite and Lipid Profiling to Assess Exposure and Effects of Produced Water Discharges on Pelagic Copepods},
  author = {Hansen, Bj{\o}rn Henrik and S{\o}rensen, Lisbet and St{\o}rseth, Trond R. and Altin, Dag and Gonzalez, Susana Villa and Skancke, J{\o}rgen and R{\o}nsberg, Marianne Unaas and Nordtug, Trond},
  year = 2020,
  month = apr,
  journal = {Science of The Total Environment},
  volume = {714},
  pages = {136674},
  issn = {0048-9697},
  doi = {10.1016/j.scitotenv.2020.136674},
  urldate = {2025-01-21},
  abstract = {Several laboratory studies have demonstrated that exposure to oil components cause toxicity to copepods, however, this has never been shown in natural populations of copepods. In the present study, we sampled copepods in an area of the North Sea with high density of oil production platforms discharging produced water. Environmental modelling was used to predict produced water and copepod trajectories prior to copepod sampling in situ. To maximise output from a minimal number of field samples, a novel and combined methodology was developed to allow exploitation of the same extract for several purposes; contaminant body burden, lipidomics, and metabolomics analysis. PAH body burdens were low compared to laboratory experiments where correlations between PAH body burden and acute toxicity, reproduction and molecular endpoints had been established. Still, station-specific PAH profiles strongly indicated copepod exposure to PW. NMR metabolomics, focusing on water-soluble metabolites, suggested no correlation between metabolites and stations. Interestingly, lipidomics analyses suggested site-specific fingerprints and profiles displayed for acyl-glycerols and wax esters. Potential effects of produced water exposure on lipid metabolism in copepods cannot be ruled out and deserves more attention. Our study exemplifies the importance of incorporating novel and improved analytical methodologies in environmental monitoring.},
  keywords = {,/done,Biota/invert/copepod,Chemicals/PAHs,ObsCite},
  annotation = {TLDR: This study sampled copepods in an area of the North Sea with high density of oil production platforms discharging produced water and found that PAH body burdens were low compared to laboratory experiments, still, station-specific PAH profiles strongly indicated copepod exposure to PW.\\
remark: Omics for PAH exposure to copepods showed little of any interest.},
  file = {C\:\\Users\\SAW\\OneDrive - NIVA\\Documents\\04 - Library\\Literature\\Sørensen et al. - 2020 - Accumulation and toxicity of monoaromatic petroleum hydrocarbons in early life stages of cod and had.pdf;C\:\\Users\\SAW\\Zotero\\storage\\XDVUATMA\\S0048969720301844.html}
}

@article{hansonEvidenceCitationBias2018,
  title = {Evidence of Citation Bias in the Pesticide Ecotoxicology Literature},
  author = {Hanson, M. L. and Deeth, L. E. and Prosser, R. S.},
  year = 2018,
  month = sep,
  journal = {Ecotoxicology},
  volume = {27},
  number = {7},
  pages = {1039--1045},
  issn = {15733017},
  doi = {10.1007/s10646-018-1918-4},
  abstract = {As scientists, we are tasked with letting evidence guide our conclusions. In the world of pesticides this takes on added importance as the data can influence ecological and human health outcomes and regulations, and even the manner in which we grow food. Yet, there seems to be a reticence to engage with the totality of the pesticide ecotoxicology literature, especially papers that report few or no effects or low risk to non-target organisms. We suspected that these studies would have fewer citations than studies that report significant effects or risk for the same compound, and this would be unrelated to the strength of the study, e.g., high quality studies with few or no effects would be cited less frequently than weaker studies that reported effects. To investigate this, we examined a subset of literature around the herbicide atrazine. We found that papers reporting an effect had significantly more citations per year than those that did not (p \textbackslash textless 0.05). There was no significant relationship between the strength of the study and number of citations, but a general trend for weaker studies to have greater number of citations. The impact factor of journals was not positively correlated with the strength of the study methods, but studies that reported effects were published in journals with a greater mean impact factor than those that reported no effects (p \textbackslash textless 0.05). This analysis reveals evidence of citation bias within the pesticide ecotoxicology literature, as well as bias by journals to publish studies that report effects, regardless of study quality.},
  keywords = {Metascience/Error/bias},
  file = {C:\Users\SAW\Zotero\storage\UFTGPXAU\Hanson et al. - 2018 - Evidence of citation bias in the pesticide ecotoxi.pdf}
}

@article{hansonHowWeCan2017,
  title = {How We Can Make Ecotoxicology More Valuable to Environmental Protection},
  author = {Hanson, M. L. and Wolff, B. A. and Green, J. W. and Kivi, M. and Panter, G. H. and Warne, M. {\relax St}. J. and {\AA}gerstrand, M. and Sumpter, J. P.},
  year = 2017,
  month = feb,
  journal = {Science of The Total Environment},
  volume = {578},
  pages = {228--235},
  issn = {0048-9697},
  doi = {10.1016/j.scitotenv.2016.07.160},
  urldate = {2023-05-13},
  abstract = {There is increasing awareness that the value of peer-reviewed scientific literature is not consistent, resulting in a growing desire to improve the practice and reporting of studies. This is especially important in the field of ecotoxicology, where regulatory decisions can be partly based on data from the peer-reviewed literature, with wide-reaching implications for environmental protection. Our objective is to improve the reporting of ecotoxicology studies so that they can be appropriately utilized in a fair and transparent fashion, based on their reliability and relevance. We propose a series of nine reporting requirements, followed by a set of recommendations for adoption by the ecotoxicology community. These reporting requirements will provide clarity on the the test chemical, experimental design and conditions, chemical identification, test organisms, exposure confirmation, measurable endpoints, how data are presented, data availability and statistical analysis. Providing these specific details will allow for a fuller assessment of the reliability and relevance of the studies, including limitations. Recommendations for the implementation of these reporting requirements are provided herein for practitioners, journals, reviewers, regulators, stakeholders, funders, and professional societies. If applied, our recommendations will improve the quality of ecotoxicology studies and their value to environmental protection.},
  langid = {english},
  keywords = {Health/HRA},
  file = {C\:\\Users\\SAW\\Zotero\\storage\\Y9FLIXZ4\\Hanson et al. - 2017 - How we can make ecotoxicology more valuable to env.pdf;C\:\\Users\\SAW\\Zotero\\storage\\DA5AG7QP\\S004896971631614X.html}
}

