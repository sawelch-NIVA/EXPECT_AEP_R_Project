@article{nguyenContributionConstructionPhase2020,
  title = {Contribution of the Construction Phase to Environmental Impacts of the Wastewater Treatment Plant},
  author = {Nguyen, Thi Kieu Loan and Ngo, Huu Hao and Guo, Wenshan and Chang, Soon Woong and Nguyen, Dinh Duc and Nguyen, Tien Vinh and Nghiem, Duc Long},
  year = 2020,
