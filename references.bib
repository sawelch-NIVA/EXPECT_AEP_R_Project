}

@article{sandersonRankingPrioritizationEnvironmental2004,
  title = {Ranking and Prioritization of Environmental Risks of Pharmaceuticals in Surface Waters},
  author = {Sanderson, Hans and Johnson, David J and Reitsma, Tamara and Brain, Richard A and Wilson, Christian J and Solomon, Keith R},
  year = 2004,
