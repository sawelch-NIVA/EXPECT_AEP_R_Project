  title = {Temporal Trends of {{Al}}, {{Fe}}, {{Cu}}, {{Mn}} and {{Zn}} Concentrations in Streams Draining Agricultural Catchments of the South-Eastern {{Norway}}},
  author = {Tesfai, M and St{\aa}lnacke, P},
