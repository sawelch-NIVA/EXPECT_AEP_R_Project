@article{liuRiskAssessmentMarine2023,
  title = {Risk Assessment of Marine Oil Spills Using Dynamic {{Bayesian}} Network Analyses},
  author = {Liu, Zengkai and Han, Zhonghao and Chen, Qi and Shi, Xuewei and Ma, Qiang and Cai, Baoping and Liu, Yonghong},
