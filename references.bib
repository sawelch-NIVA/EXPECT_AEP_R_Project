@article{fisherTacklingEmergingThreat2022,
  title = {Tackling the Emerging Threat of Antifungal Resistance to Human Health},
  author = {Fisher, Matthew C. and {Alastruey-Izquierdo}, Ana and Berman, Judith and Bicanic, Tihana and Bignell, Elaine M. and Bowyer, Paul and Bromley, Michael and Br{\"u}ggemann, Roger and Garber, Gary and Cornely, Oliver A. and Gurr, Sarah J. and Harrison, Thomas S. and Kuijper, Ed and Rhodes, Johanna and Sheppard, Donald C. and Warris, Adilia and White, P. Lewis and Xu, Jianping and Zwaan, Bas and Verweij, Paul E.},
