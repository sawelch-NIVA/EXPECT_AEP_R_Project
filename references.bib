  shorttitle = {Uptake and Internalisation of Copper by Three Marine Microalgae},
  author = {Levy, Jacqueline L. and Angel, Brad M. and Stauber, Jennifer L. and Poon, Wing L. and Simpson, Stuart L. and Cheng, Shuk Han and Jolley, Dianne F.},
  year = 2008,
