@article{lindqvistOccurrenceAcidicPharmaceuticals2005,
  title = {Occurrence of Acidic Pharmaceuticals in Raw and Treated Sewages and in Receiving Waters},
  author = {Lindqvist, Niina and Tuhkanen, Tuula and Kronberg, Leif},
  year = 2005,
  month = jun,
  journal = {Water Research},
