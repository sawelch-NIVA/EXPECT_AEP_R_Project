@article{daffornAntifoulingStrategiesHistory2011,
  title = {Antifouling Strategies: History and Regulation, Ecological Impacts and Mitigation},
  shorttitle = {Antifouling Strategies},
  author = {Dafforn, Katherine A. and Lewis, John A. and Johnston, Emma L.},
