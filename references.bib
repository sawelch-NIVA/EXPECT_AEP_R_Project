  author = {L{\"o}ve, Arnd{\'i}s Sue Ching and {Baz-Lomba}, Jose Antonio and Reid, Malcolm J. and Kankaanp{\"a}{\"a}, Aino and Gunnar, Teemu and Dam, Maria and {\'O}lafsd{\'o}ttir, Krist{\'i}n and Thomas, Kevin V.},
