@article{gonzalezgarciaAbsorptionCarbamazepineDiclofenac2018,
  title = {Absorption of Carbamazepine and Diclofenac in Hydroponically Cultivated Lettuces and Human Health Risk Assessment},
  author = {Gonz{\'a}lez Garc{\'i}a, Mariano and {Fern{\'a}ndez-L{\'o}pez}, Carmen and {Pedrero-Salcedo}, Francisco and Alarc{\'o}n, Juan Jose},
  year = 2018,
  month = jul,
  journal = {Agricultural Water Management},
  volume = {206},
  pages = {42--47},
  issn = {0378-3774},
  doi = {10.1016/j.agwat.2018.04.018},
  urldate = {2022-07-04},
  abstract = {Due to current water shortages, the use of water from wastewater treatment plants (WWTPs) for horticultural crop irrigation is becoming increasingly common. This practice implies the risk of introducing pharmaceutical compounds into the food chain. The main aim of this work was to study the accumulation of two drugs in lettuces and their subsequent transfer into the food chain. The study focused on two widely used drugs, the anticonvulsant carbamazepine (CBZ) and the anti-inflammatory diclofenac (DCF), with different physicochemical properties in terms of their hydrophobicity and solubility in water. Three varieties of lettuce were selected and irrigated with water containing a mixture of the two pharmaceutical compounds at different concentrations. The results show the leaves presented the highest levels of uptake and greatest bioconcentration factors in the case of CBZ; however, in the case of DCF, by contrast, the highest uptake levels and greatest bioconcentration factors were observed in the roots. For CBZ, the Cleaf/Croot ratio was greater than 1, indicating good root-to-leaf drug translocation, whereas all Cleaf/Croot ratios were less than 1 for DCF. From the data acquired, our evaluation suggests that the concentrations of CBZ and DCF detected in the edible part of the lettuces do not imply any risk to human health.},
  langid = {english},
  keywords = {/done,Chemicals/PPCP,Health,Society/agriculture/irrigation,Water/wastewater,Water/wastewater/treatment},
  annotation = {TLDR: The evaluation suggests that the concentrations of CBZ and DCF detected in the edible part of the lettuces do not imply any risk to human health.},
  file = {C\:\\Users\\SAW\\Zotero\\storage\\45Z8Z5Z4\\González García et al. - 2018 - Absorption of carbamazepine and diclofenac in hydr.pdf;C\:\\Users\\SAW\\Zotero\\storage\\TXNUQGTI\\S0378377418303883.html}
}

@article{gonzalezpenaPharmaceuticalsMarketConsumption2021,
  title = {Pharmaceuticals {{Market}}, {{Consumption Trends}} and {{Disease Incidence Are Not Driving}} the {{Pharmaceutical Research}} on {{Water}} and {{Wastewater}}},
  author = {Gonz{\'a}lez Pe{\~n}a, Omar Israel and L{\'o}pez Zavala, Miguel {\'A}ngel and Cabral Ruelas, H{\'e}ctor},
