@article{wangBioaccumulationBehaviourPharmaceuticals2019,
  title = {Bioaccumulation Behaviour of Pharmaceuticals and Personal Care Products in a Constructed Wetland},
  author = {Wang, Yujue and Yin, Tingru and Kelly, Barry C. and Gin, Karina Yew-Hoong},
