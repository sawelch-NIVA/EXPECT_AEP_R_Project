@article{parksanAssessingReleaseCopper2018,
  title = {Assessing the Release of Copper from Nanocopper-Treated and Conventional Copper-Treated Lumber into Marine Waters {{II}}: {{Forms}} and Bioavailability.},
  author = {{Parks AN} and {Cantwell MG} and {Katz DR} and {Cashman MA} and {Luxton TP} and {Clar JG} and {Perron MM} and {Portis L} and {Ho KT} and {Burgess RM}},
  year = 2018,
  journal = {Environ Toxicol Chem},
  volume = {37},
  number = {7},
  pages = {1969--1979},
  address = {England},
  doi = {10.1002/etc.4140},
  abstract = {One application of nanocopper is as a wood-preserving pesticide in pressure-treated lumber. Recent research has shown that pressure-treated lumber amended with micronized copper azole (MCA), which contains nanosized copper, releases copper under estuarine and marine conditions. The form of copper released (i.e., ionic, nanocopper [1-100\,nm in size]) is not fully understood but will affect the bioavailability and toxicity of the metal. In the present study, multiple lines of evidence, including size fractionation, ion-selective electrode electrochemistry, comparative toxicity, and copper speciation were used to determine the form of copper released from lumber blocks and sawdust. The results of all lines of evidence supported the hypothesis that ionic copper was released from MCA lumber and sawdust, with little evidence that nanocopper was released. For example, copper concentrations in size fractionations of lumber block aqueous leachates including unfiltered, 0.1\,{$\mu$}m, and 3\,kDa were not significantly different, suggesting that the form of copper released was in the size range operationally defined as dissolved. These results correlated with the ion-selective electrode data which detects only ionic copper. In addition, comparative toxicity testing resulted in a narrow range of median lethal concentrations (221-257\,{$\mu$}g/L) for MCA lumber blocks and CuSO(4) . We conclude that ionic copper was released from the nanocopper pressure-treated lumber under estuarine and marine conditions. Environ Toxicol Chem 2018;37:1969-1979. Published 2018 Wiley Periodicals Inc. on behalf of SETAC. This article is a US government work and, as such, is in the public domain in the United States of America.},
  langid = {english},
  keywords = {/unread},
  file = {C:\Users\SAW\Zotero\storage\NNWZPMCR\Parks AN et al. - 2018 - Assessing the release of copper from nanocopper-treated and conventional copper-treated lumber into.pdf}
}

@article{parkSilverNanoparticleAgNP2025,
  type = {Review},
  title = {Silver Nanoparticle ({{AgNP}}), Neurotoxicity, and Putative Adverse Outcome Pathway ({{AOP}}): A Review},
