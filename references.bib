}

@article{spiegelhalterDontKnowCant2011,
  ids = {spiegelhalter2011a},
  title = {Don't Know, Can't Know: Embracing Deeper Uncertainties When Analysing Risks},
  shorttitle = {Don't Know, Can't Know},
  author = {Spiegelhalter, David J. and Riesch, Hauke},
  year = 2011,
  month = dec,
  journal = {Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences},
  volume = {369},
  number = {1956},
  pages = {4730--4750},
  publisher = {Royal Society},
  doi = {10.1098/rsta.2011.0163},
  urldate = {2023-03-06},
  abstract = {Numerous types of uncertainty arise when using formal models in the analysis of risks. Uncertainty is best seen as a relation, allowing a clear separation of the object, source and `owner' of the uncertainty, and we argue that all expressions of uncertainty are constructed from judgements based on possibly inadequate assumptions, and are therefore contingent. We consider a five-level structure for assessing and communicating uncertainties, distinguishing three within-model levels---event, parameter and model uncertainty---and two extra-model levels concerning acknowledged and unknown inadequacies in the modelling process, including possible disagreements about the framing of the problem. We consider the forms of expression of uncertainty within the five levels, providing numerous examples of the way in which inadequacies in understanding are handled, and examining criticisms of the attempts taken by the Intergovernmental Panel on Climate Change to separate the likelihood of events from the confidence in the science. Expressing our confidence in the adequacy of the modelling process requires an assessment of the quality of the underlying evidence, and we draw on a scale that is widely used within evidence-based medicine. We conclude that the contingent nature of risk-modelling needs to be explicitly acknowledged in advice given to policy-makers, and that unconditional expressions of uncertainty remain an aspiration.},
  keywords = {Maths/stats/Bayesian},
  file = {C:\Users\SAW\Zotero\storage\Z7MPG4VE\spiegelhalter_et_al_2011_don't_know,_can't_know_-_embracing_deeper_uncertainties_when_analysing_risks.pdf}
}

@article{spragueLethalLevelsMixed1965,
  title = {Lethal {{Levels}} of {{Mixed Copper}}--{{Zinc Solutions}} for {{Juvenile Salmon}}},
  author = {Sprague, J. B. and Ramsay, B. Ann},
  year = 1965,
  month = feb,
  journal = {Journal of the Fisheries Research Board of Canada},
  volume = {22},
  number = {2},
  pages = {425--432},
  issn = {0015-296X},
  doi = {10.1139/f65-042},
  urldate = {2022-03-09},
  abstract = {The toxicity of copper and zinc sulphates to juvenile Atlantic salmon (Salmo salar L.) was tested in very soft water at 17 {$^\circ$}C. The salts were tested separately and in mixtures. Incipient lethal levels were 32\enspace{$\mu$}g/litre of copper alone or 420\enspace{$\mu$}g/litre of zinc alone.Concentrations were expressed in "toxic units" by taking them as proportions of incipient lethal levels. Compared this way, resistance-times were similar for the two metals. Experiments showed that the incipient lethal level for mixtures was attained when addition of toxic units contributed by each metal reached a total of 1.0. The lethal threshold was therefore governed by simple additive effect of the two toxicants. This result is useful for applying to pollution problems in the field.In stronger mixtures totalling 2 and 5 toxic units, fish died faster than would be expected from their resistance to the metals separately. This type of potentiation in short-term tests seems to account for more-than-additive effects previously reported in the literature.},
  langid = {english}
}

