@article{silleExposomeNewApproach2020,
  type = {Editorial},
  title = {The Exposome -- a New Approach for Risk Assessment},
  author = {Sill{\'e}, Fenna C.M. and Karakitsios, Spyros and Kleensang, Andr{\'e} and Koehler, Kirsten and Maertens, Alexandra and Miller, Gary W. and Prasse, Carsten and {Quir{\'o}s-Alcal{\'a}}, Lesliam and Ramachandran, Gurumurthy and Rappaport, Stephen M. and Rule, Ana M. and Sarigiannis, Dimosthenis and Smirnova, Lena and H{\"a}rtung, Thomas},
  year = 2020,
  journal = {ALTEX : Alternativen Zu Tierexperimenten},
  pages = {3--23},
  publisher = {Springer Nature},
  issn = {1868-596X},
  doi = {10.14573/altex.2001051},
  abstract = {Complementing the human genome with an exposome reflects the increasingly obvious impact of environmental exposure, which far exceeds the role of genetics, on human health. Considering the complexity of exposures and, in addition, the reactions of the body to exposures - i.e., the exposome - reverses classical exposure science where the precise measurement of single or few exposures is associated with specific health or environmental effects. The complete description of an individual's exposome is impossible; even less so is that of a population. We can, however, cast a wider net by foregoing some rigor in assessment and compensating with the statistical power of rich datasets. The advent of omics technologies enables a relatively cheap, high-content description of the biological effects of substances, especially in tissues and biofluids. They can be combined with many other rich data-streams, creating big data of exposure and effect. Computational methods increasingly allow data integration, discerning the signal from the noise and formulating hypotheses of exposure-effect relationships. These can be followed up in a targeted way. With a better exposure element in the risk equation, exposomics - new kid on the block of risk assessment - promises to identify novel exposure (interactions) and health/environment effect associations. This may also create opportunities to prioritize the more relevant chemicals for risk assessment, thereby lowering the burden on hazard assessment in an expo-sure-driven approach. Technological developments and synergies between approaches, quality assurance (ultimately as Good Exposome Practices), and the integration of mechanistic thinking will advance this approach.},
  langid = {english},
  keywords = {/unread},
  note+duplicate-1 = {Query date: 2025-05-20 11:01:20}
}

@article{sillerovahStableIsotopeTracing2017,
  title = {Stable Isotope Tracing of {{Ni}} and {{Cu}} Pollution in {{North-East Norway}}: {{Potentials}} and Drawbacks.},
  author = {{\v Sillerov\'a H} and {Chrastn\'y V} and {V\'itkov\'a M} and {Francov\'a A} and {Jehli\v cka J} and {Gutsch MR} and {Kocourkov\'a J} and {Aspholm PE} and {Nilsson LO} and {Berglen TF} and {Jensen HKB} and {Kom\'arek M}},
  year = 2017,
  journal = {Environ Pollut},
  volume = {228},
  pages = {149--157},
  address = {England},
  doi = {10.1016/j.envpol.2017.05.030},
  abstract = {The use of Ni and Cu isotopes for tracing contamination sources in the environment remains a challenging task due to the limited information about the influence of various biogeochemical processes influencing stable isotope fractionation. This work focuses on a relatively simple system in north-east Norway with two possible endmembers (smelter-bedrock) and various environmental samples (snow, soil, lichens, PM(10)). In general, the whole area is enriched in heavy Ni and Cu isotopes highlighting the impact of the smelting activity. However, the environmental samples exhibit a large range of {$\delta$}(60)Ni (-0.01~\textpm ~0.03‰ to 1.71~\textpm ~0.02‰) and {$\delta$}(65)Cu (-0.06~\textpm ~0.06‰ to~-3.94~\textpm ~0.3‰) values which exceeds the range of {$\delta$}(60)Ni and {$\delta$}(65)Cu values determined in the smelter, i.e. in feeding material and slag ({$\delta$}(60)Ni from 0.56~\textpm ~0.06‰ to 1.00~\textpm ~0.06‰ and {$\delta$}(65)Cu from~-1.67~\textpm ~0.04‰ to~-1.68~\textpm ~0.15‰). The shift toward heavier Ni and Cu {$\delta$} values was the most significant in organic rich topsoil samples in the case of Ni ({$\delta$}(60)Ni up to 1.71~\textpm ~0.02‰) and in lichens and snow in the case of Cu ({$\delta$}(65)Cu up to~-0.06~\textpm ~0.06‰ and~-0.24~\textpm ~0.04‰, respectively). These data suggest an important biological and biochemical fractionation (microorganisms and/or metal uptake by higher plants, organo-complexation etc.) of Ni and Cu isotopes, which should be quantified separately for each process and taken into account when using the stable isotopes for tracing contamination in the environment.},
  langid = {english},
  keywords = {/unread},
  file = {C\:\\Users\\SAW\\Zotero\\storage\\A3QF9AXB\\Šillerová H et al. - 2017 - Stable isotope tracing of Ni and Cu pollution in North-East Norway Potentials and drawbacks..pdf;C\:\\Users\\SAW\\Zotero\\storage\\PHTAVCWZ\\Šillerová H et al. - 2017 - Stable isotope tracing of Ni and Cu pollution in north-east Norway potentials and drawbacks.pdf}
}

