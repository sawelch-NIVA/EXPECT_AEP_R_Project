  issn = {1894-7948},
  urldate = {2024-11-28},
  abstract = {NIVA har gjennomf\o rt tiltaksorientert overv\aa king ved Eydehavn og i Trom\o ysundet i 2019 p\aa{} oppdrag for Fiven Norge AS. Overv\aa kingsprogrammet er utf\o rt i henhold til Vannforskriften p\aa{} bakgrunn av hvilke stoffer som bedriften har utslipp av til vannforekomsten. Hensikten med overv\aa kingen har v\ae rt \aa{} identifisere hvorvidt bedriftens utslipp p\aa virker vannforekomstens kjemiske tilstand. Det ble gjort analyser av arsen, bly, kadmium, kobber, krom, kvikks\o lv, nikkel og sink i pr\o ver av bl\aa skjell fra sju stasjoner. Kvikks\o lv er et av de prioriterte stoffene i Vannforskriften, og det eneste tungmetallet som det finnes EQS (grenseverdi) for i biota (20 {$\mu$}g/kg). Det var ingen konsentrasjoner i bl\aa skjell som overskred grenseverdi for kvikks\o lv. Alle stasjonene i overv\aa kingsprogrammet ble derfor klassifisert til <<god>> kjemisk tilstand. Ved sammenligning av konsentrasjoner av tungmetaller i bl\aa skjell mot beregnede verdier for h\o y bakgrunnskonsentrasjon (PROREF), var det noe forh\o yede konsentrasjoner av kobber p\aa{} fem av stasjonene og de h\o yeste konsentrasjonene var i bl\aa skjell lengst vekk fra bedriften. Dette tyder p\aa{} at det ogs\aa{} er andre kilder enn Fiven for de p\aa viste niv\aa ene av kobber. P\aa{} den ene stasjonen i Bekkevika var det ogs\aa{} forh\o yet konsentrasjon av bly i bl\aa skjellene.},
  copyright = {Navngivelse-Ikkekommersiell-DelP\aa SammeVilk\aa r 4.0 Internasjonal},
  langid = {nob},
  keywords = {,/done,Biota/invert/mollusc/mussel,Chemicals/metals/copper,Ecotox/exposure,Ecotox/monitoring},
  annotation = {Accepted: 2020-03-11T13:18:11Z\\
remark: Sigurd did some mussel-based monitoring for a company near Sandefjord.},
  file = {C:\Users\SAW\OneDrive - NIVA\Documents\04 - Library\Literature\Øxnevad - 2020 - Tiltaksorientert overvåking av Tromøysundet i 2019. Overvåking for Fiven Norge AS avd. Eydehavn.pdf}
}

@article{oygardjkSizeChargeFractionation2007,
  title = {Size Charge Fractionation of Metals in Municipal Solid Waste Landfill Leachate},
  author = {{Oygard JK} and {Gjengedal E} and {R\o yset O}},
  year = 2007,
  journal = {Water Res},
  volume = {41},
  number = {1},
  pages = {47--54},
  address = {England},
  doi = {10.1016/j.watres.2006.09.027},
  abstract = {Municipal solid waste landfill leachates from 9 Norwegian sites were size charge fractionated in the field, to obtain three fractions: particulate and colloidal matter {$>$}0.45microm, free anions/non-labile complexes {$<$}0.45microm and free cations/labile complexes {$<$}0.45microm. The fractionation showed that Cd and Zn, and especially Cu and Pb, were present to a large degree (63-98\%) as particulate and colloidal matter {$>$}0.45microm. Cr, Co and Ni were on the contrary present mostly as non-labile complexes (69-79\%) {$<$}0.45microm. The major cations Ca, Mg, K, and Mn were present mainly as free cations/labile complexes {$<$}0.45microm, while As and Mo were present to a large degree (70-90\%) as free anions/non-labile complexes {$<$}0.45microm. Aluminium was present mainly as particulate and colloidal matter {$>$}0.45microm. The particulate and colloidal matter {$>$}0.45microm was mainly inorganic; indicating that the metals present in this fraction were bound as inorganic compounds. The fractionation gives important information on the mobility and potential bioavailability of the metals investigated, in contrast to the total metal concentrations usually reported. To study possible changes in respective metal species in leachate in aerated sedimentation tanks, freshly sampled leachate was stored for 48h, and subsequently fractionated. This showed that the free heavy metals are partly immobilized during storage of leachate with oxygen available. The largest effects were found for Cd and Zn. The proportion of As and Cr present as particulate matter or colloids {$>$}0.45microm also increased.},
  langid = {english},
  keywords = {/unread},
  file = {C\:\\Users\\SAW\\Zotero\\storage\\3BLSPIQU\\Oygard JK et al. - 2007 - Size charge fractionation of metals in municipal solid waste landfill leachate.pdf;C\:\\Users\\SAW\\Zotero\\storage\\Y4Y2IRGK\\Oygard JK et al. - 2007 - Size charge fractionation of metals in municipal solid waste landfill leachate.pdf}
}

@article{pacyna-kuchtaadExposureSmallArctic2020,
  title = {Exposure of a Small {{Arctic}} Seabird, the Little Auk ({{Alle}} Alle) Breeding in {{Svalbard}}, to Selected Elements throughout the Course of a Year.},
  author = {{Pacyna-Kuchta AD} and {Jakubas D} and {Frankowski M} and {Polkowska \.Z} and {Wojczulanis-Jakubas K}},
  year = 2020,
  journal = {Sci Total Environ},
  volume = {732},
  pages = {139103},
  address = {Netherlands},
  doi = {10.1016/j.scitotenv.2020.139103},
  abstract = {The Arctic marine ecosystem can be altered by processes of natural and anthropogenic origin. Spatio-temporal variation in species exposure to contamination is still poorly understood. Here, we studied elemental concentrations in the non-lethally collected samples from the most numerous seabird in European Arctic, the little auk (Alle alle) nesting in one breeding colony in Svalbard. This seabird spent the breeding season in the high-Arctic zone and the non-breeding period in sub-Arctic areas what may implicate spatio-temporal variation in elements bioaccumulation. We determined concentrations of 19 elements in adults feathers to determine levels of exposure during part of the pre-breeding (n~=~74) and post-breeding (n~=~74) seasons, feathers from nestlings (n~=~18) to determine local contamination, and chick down (n~=~16) and post-hatching eggshells (n~=~18) to determine maternal input to offspring. During the pre-breeding period adults accumulated in their feathers significantly more Hg (one third of feathers exceeded the established toxicity threshold), Se and Mn compared to the post-breeding period. It reflects a higher exposition of birds to contaminants in pre-breeding moult areas outside the High Arctic compared to the post-breeding moult in the High Arctic. Sex differences in adult feathers representing the post-breeding period were found only for Ca and Zn with higher values in females. Chick down was characterized by high levels of several essential elements, an intermediate level of Hg and Se, and the highest Se:Hg molar ratios of all groups. Chick body feathers had the highest level of Cu and K among all the studied groups. Post-hatching eggshells were characterized by high Sr level (exceeding 2000~{$\mu$}g/g). Concentrations of several non-essential elements (Bi, Cd, Cr, Hg, Ni and Pb) in them were below method detection limits.},
  langid = {english},
  keywords = {/unread},
  file = {C\:\\Users\\SAW\\Zotero\\storage\\43M6I2VU\\Pacyna-Kuchta AD et al. - 2020 - Exposure of a small Arctic seabird, the little auk (Alle alle) breeding in Svalbard, to selected ele.pdf;C\:\\Users\\SAW\\Zotero\\storage\\HIXR5FA5\\Pacyna-Kuchta AD et al. - 2020 - Exposure of a small arctic seabird, the little auk (alle alle) breeding in svalbard, to selected ele.pdf}
}

