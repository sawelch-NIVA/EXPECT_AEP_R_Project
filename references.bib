@article{veithRulesDistinguishingToxicants1990,
  title = {Rules for Distinguishing Toxicants That Cause Type {{I}} and Type {{II}} Narcosis Syndromes},
  author = {Veith, G. D. and Broderius, S. J.},
  year = 1990,
