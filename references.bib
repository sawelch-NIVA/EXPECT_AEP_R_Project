@article{castiglioniRemovalPharmaceuticalsSewage2006,
  title = {Removal of {{Pharmaceuticals}} in {{Sewage Treatment Plants}} in {{Italy}}},
  author = {Castiglioni, Sara and Bagnati, Renzo and Fanelli, Roberto and Pomati, Francesco and Calamari, Davide and Zuccato, Ettore},
