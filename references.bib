@inproceedings{kee10AttributesThat2016,
  title = {The 10 {{Attributes}} That {{Drive Adoption}} and {{Diffusion}} of {{Computational Tools}} in {{E-Science}}},
  booktitle = {Proceedings of the {{XSEDE16 Conference}} on {{Diversity}}, {{Big Data}}, and {{Science}} at {{Scale}}},
  author = {Kee, Kerk F. and Sleiman, Mona and Williams, Michelle and Stewart, Dominique},
