@article{falconnierAgriculturalIntensificationPolicy2018,
  title = {Agricultural Intensification and Policy Interventions: {{Exploring}} Plausible Futures for Smallholder Farmers in {{Southern Mali}}},
  author = {Falconnier, Gatien N. and Descheemaeker, Katrien and Traore, Bouba and Bayoko, Arouna and Giller, Ken E.},
  year = 2018,
