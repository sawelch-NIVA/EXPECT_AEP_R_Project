@article{russellCausesMortalityEagles2014,
  title = {Causes of Mortality in Eagles Submitted to the {{National Wildlife Health Center}} 1975--2013},
  author = {Russell, Robin E. and Franson, J. Christian},
  year = 2014,
  journal = {Wildlife Society Bulletin},
  volume = {38},
  number = {4},
  pages = {697--704},
