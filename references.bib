@article{stelzenmullerRiskbasedApproachCumulative2018,
  title = {A Risk-Based Approach to Cumulative Effect Assessments for Marine Management},
  author = {Stelzenm{\"u}ller, Vanessa and Coll, Marta and Mazaris, Antonios D. and Giakoumi, Sylvaine and Katsanevakis, Stelios and Portman, Michelle E. and Degen, Renate and Mackelworth, Peter and Gimpel, Antje and Albano, Paolo G. and Almpanidou, Vasiliki and Claudet, Joachim and Essl, Franz and Evagelopoulos, Thanasis and Heymans, Johanna J. and Genov, Tilen and Kark, Salit and Micheli, Fiorenza and Pennino, Maria Grazia and Rilov, Gil and Rumes, Bob and Steenbeek, Jeroen and Ojaveer, Henn},
  year = 2018,
