  urldate = {2022-05-31},
  abstract = {The main source of natural estrogens to municipal wastewater is human excretions via urine or feces, thus their concentrations in raw wastewater should show positive linear relationship with their human excretions. This study mainly focused on their concentration relationship in raw wastewater. Based on comparison between chemical analyses and predictions through human excretion rates, the observed concentrations of estriol (E3) in municipal wastewater were found to be noticeably lower than the predicted values. The main cause for the disparity is that substantial conjugated E3 also exists in raw wastewater. This work suggested that monitoring both E3 and its conjugates is necessary to get more accurate E3 removal performance of wastewater treatment plants (WWTPs).},
  langid = {english},
  keywords = {Chemicals/estrogens,Chemicals/estrogens/estriol,Water/wastewater}
}

