@article{wangEffectsAdrenergicAantagonists2022,
  title = {Effects of Adrenergic {$\alpha$}-Antagonists on the Early Life Stages of {{Japanese}} Medaka ({{Oryzias}} Latipes)},
  author = {Wang, Haixia and Lin, Xia and He, Zepeng and Qian, Baoliu and Sun, Liwei},
  year = 2022,
  month = nov,
  journal = {Ecotoxicology},
  issn = {1573-3017},
  doi = {10.1007/s10646-022-02604-9},
  urldate = {2022-11-25},
  abstract = {The occurrence of pharmaceuticals in the aquatic environment has stimulated considerable research efforts into their potential ecotoxicological consequences. There are a number of pharmaceuticals targeting adrenergic receptors; however, relatively few studies have explored the effects of adrenergic {$\alpha$}-antagonists (or {$\alpha$}-blockers) on fish. In this study, moxisylyte was selected as a representative {$\alpha$}-blocker, and Japanese medaka embryos were exposed to moxisylyte (1--625\,{$\mu$}g/L) for 44 days. Moxisylyte caused no significant or only marginal effects on the mortality, development, and growth; however, most genes involved in detoxification and antioxidant were transcriptionally upregulated, and antioxidant enzymes activities were induced as well. Moxisylyte exposure resulted in transcriptional downregulation of most of the steroidogenesis genes, and accordingly, the mRNA levels of steroid hormone receptors and vitellogenin decreased, particularly in males, indicating that moxisylyte disrupts the hypothalamic-pituitary-gonadal (HPG) axis in a gender-specific manner. Therefore, the risk of {$\alpha$}-blockers on fish should not be overlooked and deserves further investigation.},
  langid = {english},
  keywords = {Chemicals/EDC},
  file = {C:\Users\SAW\OneDrive\Literature\2022\wang_et_al_2022_effects_of_adrenergic_α-antagonists_on_the_early_life_stages_of_japanese_medaka.pdf}
}

