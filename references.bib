@article{brooksDissolvedOrganicCarbon2008,
  title = {Dissolved Organic Carbon Reduces the Toxicity of Copper to Germlings of the Macroalgae, {\emph{Fucus Vesiculosus}}},
  author = {Brooks, Steven J. and Bolam, Thi and Tolhurst, Laura and Bassett, Janice and La Roche, Jay and Waldock, Mike and Barry, Jon and Thomas, Kevin V.},
  year = 2008,
  month = may,
  journal = {Ecotoxicology and Environmental Safety},
  volume = {70},
  number = {1},
  pages = {88--98},
  issn = {0147-6513},
  doi = {10.1016/j.ecoenv.2007.04.007},
  urldate = {2025-05-19},
  abstract = {This study investigates the effects of waterborne copper exposure on germling growth in chemically defined seawater. Germlings of the macroalgae, Fucus vesiculosus were exposed to a range of copper and dissolved organic carbon (DOC as humic acid) concentrations over 14 days. Germling growth was found to be a sensitive indicator of copper exposure with total copper (TCu) and labile copper (LCu) EC50 values of approximately 40 and 20{$\mu$}g/L, respectively, in the absence of added DOC. The addition of DOC into the exposure media provided germlings with protection against copper toxicity, with an increased TCu EC50 value of 117.3{$\mu$}g/L at a corrected DOC (cDOC from humic acid only) concentration of 2.03mg/L. The LCu EC50 was not affected by a cDOC concentration of 1.65mg/L or less, suggesting that the LCu concentration not the TCu concentration was responsible for inhibiting germling growth. However, at a cDOC concentration of approximately 2mg/L an increase in the LCu EC50 suggests that the LCu concentration may play a role in the overall toxicity to the germlings. This is contrary to current understanding of aquatic copper toxicity and possible explanations for this are discussed.},
  langid = {english},
  keywords = {/unread,Copper,DOC,Ecotoxicology,Effect concentration,Fucus vesiculosus,Humic acid,Macroalgae},
  annotation = {TLDR: Germling growth was found to be a sensitive indicator of copper exposure with total copper (TCu) and labile copper (LCu) EC(50) values of approximately 40 and 20 microg/L, respectively, in the absence of added DOC, suggesting that the LCu concentration not the TCu concentration was responsible for inhibiting germling growth.\\
Citations: 26 (Crossref) [2025-09-26]\\
Citations: 34 (SemanticScholar) [2025-09-26]},
  file = {C\:\\Users\\SAW\\Zotero\\storage\\G4NVPP9F\\Brooks et al. - 2008 - Dissolved organic carbon reduces the toxicity of copper to germlings of the macroalgae, fucus ves.pdf;C\:\\Users\\SAW\\Zotero\\storage\\ZB6HELB6\\S0147651307000802.html}
}

