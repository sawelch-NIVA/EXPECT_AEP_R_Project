@article{jarabekMechanisticIntegrationExposure2019,
  type = {Review},
  title = {Mechanistic Integration of Exposure and Effects: Advances to Apply Systems Toxicology in Support of Regulatory Decision-Making},
  shorttitle = {Mechanistic Integration of Exposure and Effects},
