  title = {Modelling Chronic Toxicokinetics and Toxicodynamics of Copper in Mussels Considering Ionoregulatory Homeostasis and Oxidative Stress},
  author = {Le, T. T. Yen and Nachev, Milen and Grabner, Daniel and Garcia, Miriam R. and {Balsa-Canto}, Eva and Hendriks, A. Jan and Peijnenburg, Willie J. G. M. and Sures, Bernd},
  year = 2021,
  month = oct,
