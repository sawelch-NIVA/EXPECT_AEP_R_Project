  funding-text = {The authors thank Prof. Yang Yun from Shanxi University and Prof. Jianmin Chen from Fudan University for their helpful discussion. This work was supported by the National Natural Science Foundation of China (U22A20405 and 22406026).},
  journal-iso = {Environ. Sci. Technol.},
  keywords-plus = {POLYCYCLIC AROMATIC-HYDROCARBONS; PARTICULATE MATTER; EXPOSURE; PARTICLES; ACIDITY; HEALTH; NANOPARTICLES; CYTOTOXICITY; DEPOSITION; POLLUTION},
