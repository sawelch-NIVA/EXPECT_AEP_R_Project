@article{mushegianOriginEvolutionProteinCoupled2012,
  title = {The {{Origin}} and {{Evolution}} of {{G Protein-Coupled Receptor Kinases}}},
  author = {Mushegian, Arcady and Gurevich, Vsevolod V. and Gurevich, Eugenia V.},
  year = 2012,
  month = mar,
  journal = {PLOS ONE},
  volume = {7},
  number = {3},
  pages = {e33806},
  publisher = {Public Library of Science},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0033806},
  urldate = {2021-02-01},
  abstract = {G protein-coupled receptor (GPCR) kinases (GRKs) play key role in homologous desensitization of GPCRs. GRKs phosphorylate activated receptors, promoting high affinity binding of arrestins, which precludes G protein coupling. Direct binding to active GPCRs activates GRKs, so that they selectively phosphorylate only the activated form of the receptor regardless of the accessibility of the substrate peptides within it and their Ser/Thr-containing sequence. Mammalian GRKs were classified into three main lineages, but earlier GRK evolution has not been studied. Here we show that GRKs emerged at the early stages of eukaryotic evolution via an insertion of a kinase similar to ribosomal protein S6 kinase into a loop in RGS domain. GRKs in Metazoa fall into two clades, one including GRK2 and GRK3, and the other consisting of all remaining GRKs, split into GRK1-GRK7 lineage and GRK4-GRK5-GRK6 lineage in vertebrates. One representative of each of the two ancient clades is found as early as placozoan Trichoplax adhaerens. Several protists, two oomycetes and unicellular brown algae have one GRK-like protein, suggesting that the insertion of a kinase domain into the RGS domain preceded the origin of Metazoa. The two GRK families acquired distinct structural units in the N- and C-termini responsible for membrane recruitment and receptor association. Thus, GRKs apparently emerged before animals and rapidly expanded in true Metazoa, most likely due to the need for rapid signalling adjustments in fast-moving animals.},
  langid = {english},
  keywords = {Biota/invert,Biota/verts},
  file = {C\:\\Users\\SAW\\Zotero\\storage\\VCNLISGK\\Mushegian et al. - 2012 - The Origin and Evolution of G Protein-Coupled Rece.pdf;C\:\\Users\\SAW\\Zotero\\storage\\PK7PSAJU\\article.html}
}

@article{muthannatmSnowmeltPollutantRemoval2007,
  title = {Snowmelt Pollutant Removal in Bioretention Areas},
  author = {{Muthanna TM} and {Viklander M} and {Blecken G} and {Thorolfsson ST}},
  year = 2007,
  journal = {Water Res},
  volume = {41},
  number = {18},
  pages = {4061--72},
  address = {England},
  doi = {10.1016/j.watres.2007.05.040},
  abstract = {Snow accumulating in urban areas and alongside roads can accumulate high pollutant loads and the subsequent snowmelt can produce high pollutant loads in receiving waters. This paper examines the treatment of roadside snowmelt in bioretention with respect to pollutant removal, pollutant pathways, and major sinks. Bioretention was used to treat snowmelt from three types of urban roads in Trondheim, Norway: residential, medium, and roads with high-density traffic. Metal retention in bioretention boxes had a mass reduction in zinc, copper, lead, and cadmium in the range of 89-99\%, and a decrease in outflow concentrations in the range 81-99\%. Cadmium was only measured in the water samples, while the other three metals were traced through the system to identify the main sinks. The top mulch layer was the largest sink for the retained metals, with up to 74\% of the zinc retained in this mulch layer. The plant metal uptakes were only 2-8\% of the total metal retention; however, the plants still play an important role with respect to root zone development and regeneration, which fosters infiltration and reduces the outflow load. Dissolved pollutants in snowmelt tend to be removed with the first flush of meltwater, creating an enrichment ratio with respect to the average pollutant concentrations in the snow. The effect of this enrichment ratio was examined through the bioretention system, and found to be less predominant than that typically reported for untreated snowmelt. The enrichment factors were in the range of 0.65-1.51 for the studied metals.},
  langid = {english},
  keywords = {/unread},
  file = {C:\Users\SAW\Zotero\storage\7DXNRCV6\Muthanna TM et al. - 2007 - Snowmelt pollutant removal in bioretention areas.pdf}
}

@article{mutluAutomatedCurationSpatial2025,
  title = {Automated Curation of Spatial Metadata in Environmental Monitoring Data},
  author = {Mutlu, {\.I}lhan and Hackerm{\"u}ller, J{\"o}rg and Schor, Jana},
  year = 2025,
  month = may,
  journal = {Ecological Informatics},
  volume = {86},
  pages = {103038},
  issn = {1574-9541},
  doi = {10.1016/j.ecoinf.2025.103038},
  urldate = {2026-02-04},
  abstract = {Spatial data accuracy in environmental monitoring is crucial for practical large-scale data analytics and the development of AI models. In this context, spatial data is metadata and faces the same challenges as any other metadata, like missing values, false or contradicting information, formatting problems of textual data and numbers, the usage of different languages, and more. These issues severely limit the usability of the data. With this study, we provide an automatic approach, CleanGeoStreamR, to resolve as many of these issues as possible for the spatially annotated environmental monitoring database. We substantially increased the quality of the spatial metadata and, therefore, the quantity of data points that can be used in large-scale data analytics and AI applications. Further, our goal is to raise awareness about the issues related to spatial metadata and promote the implementation of our concepts in other environmental monitoring data sources. Advanced understanding and the availability of automatic approaches like the presented method will substantially contribute to making environmental monitoring data FAIR and enhance its usability in the era of Big Data and AI.},
  langid = {english},
  keywords = {/unread,AI applications in hydrology,Automated data curation,Big data analytics,Environmental monitoring,Spatial data accuracy},
  file = {C\:\\Users\\SAW\\Zotero\\storage\\4HI5K3FA\\Mutlu et al. - 2025 - Automated curation of spatial metadata in environmental monitoring data.pdf;C\:\\Users\\SAW\\Zotero\\storage\\HS45XNRF\\S1574954125000470.html}
}

