@article{fayPracticalApproachesAdverse2017,
  title = {Practical Approaches to Adverse Outcome Pathway Development and Weight-of-evidence Evaluation as Illustrated by Ecotoxicological Case Studies},
  author = {Fay, Kellie A. and Villeneuve, Daniel L. and LaLone, Carlie A. and Song, You and Tollefsen, Knut Erik and Ankley, Gerald T.},
  year = 2017,
  journal = {Environmental Toxicology and Chemistry},
  volume = {36},
  number = {6},
  pages = {1429--1449},
  publisher = {Wiley},
  issn = {0730-7268},
  doi = {10.1002/etc.3770},
  urldate = {2025-06-11},
  abstract = {Abstract Adverse outcome pathways (AOPs) describe toxicant effects as a sequential chain of causally linked events beginning with a molecular perturbation and culminating in an adverse outcome at an individual or population level. Strategies for developing AOPs are still evolving and depend largely on the intended use or motivation for development and data availability. The present review describes 4 ecotoxicological AOP case studies, developed for different purposes. In each situation, creation of the AOP began in a manner determined by the initial motivation for its creation and expanded either to include additional components of the pathway or to address the domains of applicability in terms of chemical initiators, susceptible species, life stages, and so forth. Some general strategies can be gleaned from these case studies, which a developer may find to be useful for supporting an existing AOP or creating a new one. Several web-based tools that can aid in AOP assembly and evaluation of weight of evidence for scientific robustness of AOP components are highlighted. Environ Toxicol Chem 2017;36:1429--1449.  2017 SETAC},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {,/done,Ecotox/STOP/AOP},
  annotation = {TLDR: Four ecotoxicological AOP case studies are described, developed for different purposes, and several web-based tools that can aid in AOP assembly and evaluation of weight of evidence for scientific robustness of AOP components are highlighted.\\
remark: Some notes on AOP development. Little of relevance to AEPs.},
  note+duplicate-1 = {Query date: 2025-05-20 11:01:20},
  file = {C:\Users\SAW\Zotero\storage\97JU6CXX\Fay et al. - 2017 - Practical approaches to adverse outcome pathway development and weight-of-evidence evaluation as ill.pdf}
