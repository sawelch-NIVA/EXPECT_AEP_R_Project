  shorttitle = {Removal Efficiency of Pharmaceuticals during the Wastewater Treatment Process},
  author = {{Chaber-Jarlachowicz}, Paulina and Gworek, Barbara and Kalinowski, Rados{\l}aw},
  year = 2025,
  month = sep,
  journal = {PLOS One},
