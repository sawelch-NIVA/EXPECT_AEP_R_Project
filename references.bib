@article{teodosiuEnvironmentalAssessmentMunicipal2016,
  title = {Environmental Assessment of Municipal Wastewater Discharges: A Comparative Study of Evaluation Methods},
  shorttitle = {Environmental Assessment of Municipal Wastewater Discharges},
  author = {Teodosiu, Carmen and Barjoveanu, George and Sluser, Brindusa Robu and Popa, Simona Andreea Ene and Trofin, Orest},
