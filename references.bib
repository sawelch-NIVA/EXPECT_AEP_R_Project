@article{moneyImprovingRelevanceEfficiency2017,
  title = {Improving the Relevance and Efficiency of Human Exposure Assessments within the Process of Regulatory Risk Assessment},
  author = {Money, Chris},
  year = 2017,
  journal = {Environmental Science: Processes \& Impacts},
  volume = {20},
