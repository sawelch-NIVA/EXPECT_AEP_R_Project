}

@incollection{saherReviewNotesRole2025,
  title = {A Review Notes on Role, Behavior, Risk Assessment Tools, and Adverse Outcomes of Metal and Microplastic Pollution in Benthic Sea Food Ecosystem},
  booktitle = {Recent {{Trends}} in {{Marine Toxicological Assessment}}},
  author = {Saher, Noor Us and Siddiqui, Asmat Saleem and Baloch, Abdul Hameed and Ali, Wajid and Tahir, Raheema and {e Shahwar}, Dur and Shah, Muntaha and Kanwal, Nayab and Abbas, Fakhar I. and Qureshi, Naureen Aziz},
