@article{gillanStructureSedimentassociatedMicrobial2005,
  title = {Structure of Sediment-Associated Microbial Communities along a Heavy-Metal Contamination Gradient in the Marine Environment},
  author = {Gillan, {\relax DC} and Danis, B and Pernet, P and Joly, G and Dubois, P},
  year = 2005,
  journal = {APPLIED AND ENVIRONMENTAL MICROBIOLOGY},
  volume = {71},
  number = {2},
  pages = {679--690},
  doi = {10.1128/AEM.71.2.679-690.2005},
  abstract = {Microbial community composition and structure were characterized in marine sediments contaminated for {$>$}80 years with cadmium, copper, lead, and zinc. Four sampling sites that encompass a wide range of sediment metal loads were compared in a Norwegian fjord (Sorfjord). HCI-extractable metals and organic matter constantly decreased from the most contaminated site (SI) to the control site (S4). All sampling sites presented low polychlorinated biphenyl (PCB) concentrations (Sigma(7)PCB {$<$} 7.0 ng g [dry weight](-1)) The biomass ranged from 4.3 X 10(8) to 13.4 X 10(8) cells g (dry weight) of sediments(-1) and was not correlated to metal levels. Denaturing gradient gel electrophoresis indicated that diversity was not affected by the contamination. The majority of the partial 16S rRNA sequences obtained were classified in the gamma- and delta-Proteobacteria and in the C,tophaga-Flexibacter-Bacteroides (CFB) bacteria. Some sequences were closely related to other sequences from polluted marine sediments. The abundances of seven phylogenetic groups were determined by using fluorescent in situ hybridization (FISH). FISH was impaired in S1 by high levels of autofluorescing particles. For S2 to S4, the results indicated that the HCI-extractable Cu, Pb, and Zn were negatively correlated with the abundance of gamma-Proteobacteria and CFB bacteria. delta-Proteobacteria were not correlated with 110-extractable metals. Bacteria of the Desuffiosarcina-Desulfococcus group were detected in every site and represented 6 to 14\% of the DAPI (4',6'-diamidino-2-phenylindole) counts. Although factors other than metals may explain the distribution observed, the information presented here may be useful in predicting long-term effects of heavy-metal contamination in the marine environment.},
  langid = {english},
  keywords = {/unread},
  annotation = {TLDR: Microbial community composition and structure were characterized in marine sediments contaminated for {$>$}80 years with cadmium, copper, lead, and zinc and the information presented here may be useful in predicting long-term effects of heavy-metal contamination in the marine environment.},
