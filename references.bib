  type = {Article},
  title = {Assessment of Skin Sensitization Potential of Zinc Oxide, Aluminum Oxide, Manganese Oxide, and Copper Oxide Nanoparticles through the Local Lymph Node Assay: 5-Bromo-Deoxyuridine Flow Cytometry Method},
