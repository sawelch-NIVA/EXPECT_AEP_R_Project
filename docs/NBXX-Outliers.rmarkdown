# Outliers by campaign

@fig-outliers-campaign shows distributions grouped by monitoring campaign. @tbl-outliers-campaign-comments summarises the flagged measurements.

```{r}
#| label: outliers-campaign-flag
gadus_morhua_by_campaign <- gadus_morhua |>
  mutate(
    CAMPAIGN_NAME = str_remove(
      CAMPAIGN_NAME,
      "Vannmiljø Copper Monitoring 2010-2025"
    )
  ) |>
  group_by(CAMPAIGN_NAME) |>
  mutate(
    RMZ = robust_modified_z_score(MEASURED_VALUE_STANDARD),
    log_val = log10(MEASURED_VALUE_STANDARD),
    Q1 = quantile(log_val, 0.25),
    Q3 = quantile(log_val, 0.75),
    IQR = IQR(log_val) * 1.5,
    outlier_RMZ = abs(RMZ) > 3.5,
    outlier_IQR = log_val < (Q1 - IQR) | log_val > (Q3 + IQR),
    dot_fill = factor(outlier_RMZ + outlier_IQR),
    campaign_and_n = glue("**{CAMPAIGN_NAME}** <br> (n = {n()})") |>
      as.character()
  )

# More errors here
dip_results_campaign <- gadus_morhua_by_campaign |>
  group_by(CAMPAIGN_NAME, campaign_and_n) |>
  reframe(
    dip_p = dip.test(MEASURED_VALUE_STANDARD)$p.value
  ) |>
  mutate(bimodal = dip_p < 0.05)
```

```{r}
